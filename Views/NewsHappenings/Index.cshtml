@model IEnumerable<RU_ASP_Semester_Project.Models.News>

@{
    ViewData["Title"] = "News & Happenings";
}

<div class="news-page">

    <div class="news-heading">

        <div class="news-breadcrumb">
            <a href="/">Rockford.edu</a> / Student Portal / News & Happenings
        </div>

        <div class="news-heading-top">
            <div>
                <h1>News & Happenings</h1>

                <p>
                    Stay up to date with the latest campus news,
                    announcements, and happenings.
                </p>
            </div>

            <a href="/NewsHappenings/NewsHappeningsForm" class="news-submit-button">
                + Submit News Item
            </a>
        </div>

    </div>

    <div class="news-list">

        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <article class="news-card">

                    @if (!string.IsNullOrEmpty(item.NewsImagePath))
                    {
                        <img src="@item.NewsImagePath"
                             alt="@item.Title"
                             class="news-image" />
                    }

                    <div class="news-content">

                        @if (item.PublishedDate.HasValue)
                        {
                            <span class="news-date">
                                @item.PublishedDate.Value.ToString("MMMM dd, yyyy")
                            </span>
                        }

                        <h2>
                            <a asp-controller="NewsHappenings"
                               asp-action="Details"
                               asp-route-id="@item.NewsId"> @item.Title
                            </a>
                        </h2>

                        <p>@item.Content</p>

                        <a asp-controller="NewsHappenings"
                           asp-action="Details"
                           asp-route-id="@item.NewsId"
                           class="news-read-more"> Read More →
                        </a>

                    </div>
                </article>
            }
        }
        else
        {
            <p>There are currently no news articles available.</p>
        }

    </div>

</div>
